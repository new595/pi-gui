diff --git a/apps/desktop/tests/helpers/proxy-fixture.ts b/apps/desktop/tests/helpers/proxy-fixture.ts
new file mode 100644
index 0000000..738701e
--- /dev/null
+++ b/apps/desktop/tests/helpers/proxy-fixture.ts
@@ -0,0 +1,89 @@
+import { createServer, type Server } from "node:http";
+import { connect, type AddressInfo, type Server as NetServer, type Socket } from "node:net";
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+
+const execFileAsync = promisify(execFile);
+
+export async function runNodeWithTrustedTestCertificate(
+  helperPath: string,
+  args: readonly string[],
+  certificatePath: string,
+): Promise<{ readonly stdout: string; readonly stderr: string }> {
+  return execFileAsync(process.execPath, [helperPath, ...args], {
+    cwd: process.cwd(),
+    env: { ...process.env, NODE_EXTRA_CA_CERTS: certificatePath },
+    timeout: 15_000,
+    windowsHide: true,
+  });
+}
+
+export interface LocalConnectProxy {
+  readonly url: string;
+  readonly tunnels: () => number;
+  close(): Promise<void>;
+}
+
+/** A real loopback HTTP forward proxy that establishes CONNECT tunnels. */
+export async function startLocalConnectProxy(): Promise<LocalConnectProxy> {
+  let tunnelCount = 0;
+  const sockets = new Set<Socket>();
+  const proxy: Server = createServer((_request, response) => {
+    response.writeHead(501);
+    response.end("Only CONNECT is supported by this fixture");
+  });
+  proxy.on("connection", (socket) => {
+    sockets.add(socket);
+    socket.once("close", () => sockets.delete(socket));
+  });
+  proxy.on("connect", (request, client, head) => {
+    const separator = request.url?.lastIndexOf(":") ?? -1;
+    const hostname = request.url?.slice(0, separator);
+    const port = Number(request.url?.slice(separator + 1));
+    if (!hostname || !Number.isInteger(port) || port < 1 || port > 65535) {
+      client.end("HTTP/1.1 400 Bad Request\r\n\r\n");
+      return;
+    }
+    const upstream = connect(port, hostname);
+    sockets.add(upstream);
+    upstream.once("close", () => sockets.delete(upstream));
+    upstream.once("connect", () => {
+      tunnelCount += 1;
+      client.write("HTTP/1.1 200 Connection Established\r\n\r\n");
+      if (head.length) upstream.write(head);
+      client.pipe(upstream);
+      upstream.pipe(client);
+    });
+    upstream.once("error", () => client.destroy());
+  });
+  await new Promise<void>((resolve, reject) => {
+    proxy.once("error", reject);
+    proxy.listen(0, "127.0.0.1", () => {
+      proxy.off("error", reject);
+      resolve();
+    });
+  });
+  const address = proxy.address() as AddressInfo;
+  return {
+    url: `http://127.0.0.1:${address.port}`,
+    tunnels: () => tunnelCount,
+    close: async () => {
+      for (const socket of sockets) socket.destroy();
+      await new Promise<void>((resolve, reject) => {
+        proxy.close((error) => (error ? reject(error) : resolve()));
+      });
+    },
+  };
+}
+
+export async function listenLoopback(server: NetServer): Promise<string> {
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => {
+      server.off("error", reject);
+      resolve();
+    });
+  });
+  const address = server.address() as AddressInfo;
+  return `http://127.0.0.1:${address.port}`;
+}
diff --git a/apps/desktop/tests/helpers/proxy-tls-child.mjs b/apps/desktop/tests/helpers/proxy-tls-child.mjs
new file mode 100644
index 0000000..77fa653
--- /dev/null
+++ b/apps/desktop/tests/helpers/proxy-tls-child.mjs
@@ -0,0 +1,57 @@
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { createJiti } from "jiti";
+
+const [httpProxy, httpsProxy, plainUrl, secureUrl, websocketUrl] = process.argv.slice(2);
+if (!httpProxy || !httpsProxy || !plainUrl || !secureUrl || !websocketUrl) {
+  throw new Error("The proxy TLS child requires both proxies and all three local URLs.");
+}
+
+const source = path.resolve("apps/desktop/electron/network/desktop-proxy.ts");
+const jiti = createJiti(source);
+const { createDesktopProxyDispatcher, initializeDesktopProxy } = await jiti.import(source);
+const { fetch } = await import("undici");
+
+const dispatcher = createDesktopProxyDispatcher(
+  {},
+  { HTTP_PROXY: httpProxy, HTTPS_PROXY: httpsProxy, NO_PROXY: "" },
+);
+try {
+  const plainResponse = await fetch(plainUrl, { dispatcher });
+  if ((await plainResponse.text()) !== "http-through-proxy") {
+    throw new Error("HTTP fixture response mismatch.");
+  }
+  const secureResponse = await fetch(secureUrl, { dispatcher });
+  if ((await secureResponse.text()) !== "tls-through-proxy") {
+    throw new Error("HTTPS fixture response mismatch.");
+  }
+} finally {
+  await dispatcher.close();
+}
+
+const agentDir = await mkdtemp(path.join(tmpdir(), "pi-gui-proxy-wss-"));
+try {
+  await writeFile(path.join(agentDir, "settings.json"), JSON.stringify({ httpProxy: httpsProxy }));
+  const installed = await initializeDesktopProxy({ agentDir, env: { NO_PROXY: "" } });
+  try {
+    const socket = new WebSocket(websocketUrl);
+    const closed = new Promise((resolve) =>
+      socket.addEventListener("close", resolve, { once: true }),
+    );
+    const message = await new Promise((resolve, reject) => {
+      socket.addEventListener("message", (event) => resolve(String(event.data)), { once: true });
+      socket.addEventListener("error", () => reject(new Error("WSS fixture connection failed.")), {
+        once: true,
+      });
+    });
+    if (message !== "ok") throw new Error("WSS fixture message mismatch.");
+    await closed;
+  } finally {
+    await installed.destroy();
+  }
+} finally {
+  await rm(agentDir, { recursive: true, force: true });
+}
+
+process.stdout.write("HTTP, HTTPS, and WSS proxy fixtures passed\n");
diff --git a/apps/desktop/tests/live/proxy-live.spec.ts b/apps/desktop/tests/live/proxy-live.spec.ts
new file mode 100644
index 0000000..c061963
--- /dev/null
+++ b/apps/desktop/tests/live/proxy-live.spec.ts
@@ -0,0 +1,601 @@
+import { createServer, connect, type Socket } from "node:net";
+import { chmod, mkdir, mkdtemp, readFile, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { expect, test, type Page } from "@playwright/test";
+import {
+  launchDesktop,
+  launchDesktopByExecutable,
+  type DesktopHarness,
+} from "../helpers/electron-app";
+
+type TunnelRecord = {
+  target: string;
+  status: number;
+  clientBytes: number;
+  proxyBytes: number;
+};
+
+type ProxyRelay = {
+  readonly url: string;
+  readonly records: TunnelRecord[];
+  close(): Promise<void>;
+};
+
+type NetworkEvidence = {
+  webSocket: {
+    constructed: number;
+    opened: number;
+    messages: number;
+    sent: number;
+    closed: number;
+    forcedFailures: number;
+  };
+  fetch: {
+    count: number;
+    sseFrameCount: number;
+    responses: Array<{ status: number; contentType: string; sseFrames: number }>;
+  };
+};
+
+const REAL_AUTH_ENABLED = process.env.PI_APP_REAL_AUTH === "1";
+const AUTH_SOURCE_DIR = process.env.PI_APP_REAL_AUTH_SOURCE_DIR?.trim();
+const PROVIDER = process.env.PI_GUI_PROVIDER?.trim() || "openai-codex";
+const MODEL = process.env.PI_GUI_MODEL?.trim() || "gpt-6-luna";
+const PACKAGED = process.env.PI_PROXY_PACKAGED === "1";
+const SHELL_PATH = process.env.PI_PROXY_SHELL_PATH?.trim();
+const DESKTOP_DIR = resolve(__dirname, "../..");
+const REPO_ROOT = resolve(DESKTOP_DIR, "../..");
+
+test.describe("live proxy verification", () => {
+  test.describe.configure({ mode: "serial" });
+
+  test.beforeEach(({}, testInfo) => {
+    testInfo.setTimeout(300_000);
+    if (!REAL_AUTH_ENABLED || !AUTH_SOURCE_DIR) {
+      testInfo.skip(
+        !REAL_AUTH_ENABLED,
+        "Set PI_APP_REAL_AUTH=1 and PI_APP_REAL_AUTH_SOURCE_DIR to run real-provider proxy verification.",
+      );
+    }
+    if (!AUTH_SOURCE_DIR) {
+      throw new Error("PI_APP_REAL_AUTH=1 requires PI_APP_REAL_AUTH_SOURCE_DIR.");
+    }
+  });
+
+  test("real WebSocket conversation, follow-up and echo tool use go through the proxy", async () => {
+    await runProxyConversation({ forceWebSocketFailure: false });
+  });
+
+  test("a failed WebSocket construction falls back to real SSE through the proxy", async () => {
+    await runProxyConversation({ forceWebSocketFailure: true });
+  });
+});
+
+async function runProxyConversation(options: { forceWebSocketFailure: boolean }): Promise<void> {
+  const info = test.info();
+  const evidenceDir = info.outputPath();
+  await mkdir(evidenceDir, { recursive: true });
+
+  const privateRoot = await mkdtemp(join(tmpdir(), "pi-gui-proxy-private-"));
+  await chmod(privateRoot, 0o700);
+  const profile = join(privateRoot, "profile");
+  const agentDir = join(privateRoot, "agent");
+  const workspace = join(privateRoot, "workspace");
+  await mkdir(agentDir, { recursive: true, mode: 0o700 });
+  await mkdir(workspace, { recursive: true, mode: 0o700 });
+
+  const sourceDir = AUTH_SOURCE_DIR;
+  if (!sourceDir) throw new Error("Real provider auth source is unavailable.");
+  if (!SHELL_PATH) throw new Error("PI_PROXY_SHELL_PATH must point to a usable Bash executable.");
+  const sourceAuth = JSON.parse(await readFile(join(sourceDir, "auth.json"), "utf8")) as Record<
+    string,
+    unknown
+  >;
+  const selectedCredentials = sourceAuth[PROVIDER];
+  if (!selectedCredentials) {
+    throw new Error(`No saved credentials for selected provider ${PROVIDER}.`);
+  }
+  await writeFile(
+    join(agentDir, "auth.json"),
+    `${JSON.stringify({ [PROVIDER]: selectedCredentials })}\n`,
+    { mode: 0o600 },
+  );
+
+  const relay = await startConnectRelay();
